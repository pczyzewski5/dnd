{% extends 'base.html.twig' %}
{% block body %}
    <style>
        #participant-ids {
            display: none;
        }
    </style>
    <div class="buttons">
        <a class="button is-small is-primary" href="{{ path('participant_add', {'monsterId': '33626136-3261-6332-2d36-3137352d3131'}) }}">Dodaj potworka</a>
        <a class="button is-small is-danger" href="{{ path('encounter_delete') }}">Usuń potyczkę</a>
    </div>

    {% set i = 1 %}
    {% set participants = encounter.getParticipants().getAll() %}
    {% for participant in participants %}
        {% if participant.getId() == participants|first.getId() %}
            <div class="columns">
        {% endif %}

        <div class="column is-one-quarter">
            {{ include('encounter/participant.html.twig') }}
            {{ include('encounter/image_modal.html.twig') }}
        </div>

        {% if i is divisible by(4) %}
            </div>
        {% endif %}
        {% if i is divisible by(4) and participants|length > i %}
            <div class="columns">
        {% endif %}
        {% if participants|last.getId() == participant.getId() %}
            </div>
        {% endif %}
        {% set i = i + 1 %}
    {% endfor %}

    {{ include('encounter/swap_modal.html.twig') }}

    <span id="participant-ids" data-ids="{{ encounter.getParticipants().getIds()|join('|') }}"></span>

    <script src="{{ asset('js/encounter_note_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_hp_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_swap_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_modal_helper.js') }}"></script>
{% endblock %}