{% extends 'base.html.twig' %}
{% block body %}
    <style>
        #participant-ids {
            display: none;
        }
    </style>
    <div class="buttons">
        <a class="button is-small is-primary" href="{{ path('participant_add', {'uuid': '33626136-3261-6332-2d36-3137352d3131'}) }}">Dodaj potworka</a>
        <a class="button is-small is-danger" href="{{ path('encounter_delete') }}">Usuń potyczkę</a>
    </div>
    {% for participant in encounter.getParticipants() %}
        id: {{ participant.getId() }} | name: {{ participant.getName() }} | Max HP: {{ participant.getMaxHp() }} | Actual HP: {{ participant.getActualHp() }} | HP HISTORY: {{ participant.getHpHistory()|join(', ') }}<br>
        <div class="buttons">
            <button class="button is-small is-primary swap-id" data-actual-id="{{ participant.getId() }}" data-href="{{ path('participant_swap', {'participantId': participant.getId(), 'swapId': ':swapId'}) }}">zamień id</button>

            <a class="button is-small is-warning" href="{{ path('participant_delete', {'participantId': participant.getId()}) }}">Usuń potworka</a>
            <a class="button is-small is-info" href="{{ path('participant_duplicate', {'participantId': participant.getId()}) }}">Duplikuj potworka</a>
            <input type="number" min="0" max="1000" placeholder="0" id="hp">
            <button class="button is-small is-primary hp" data-href="{{ path('participant_add_hp', {'participantId': participant.getId(), 'hp': ':hp'}) }}">Dodaj PW</button>
            <button class="button is-small is-primary hp" data-href="{{ path('participant_remove_hp', {'participantId': participant.getId(), 'hp': ':hp'}) }}">Usuń PW</button>
            <a class="button is-small is-warning" href="{{ path('participant_hp_rollback', {'participantId': participant.getId()}) }}">rollback PW</a>
            <textarea placeholder="notes..." rows="4" cols="50" id="notes">{{ participant.getNote() }}</textarea>
            <a class="button is-small is-info save-note" href="{{ path('participant_note_add', {'participantId': participant.getId(), 'note': ':note'}) }}">zapisz notkę</a>
        </div>
    {% endfor %}

    <div class="modal">
        <div class="modal-background"></div>
        <div class="modal-card">
            <section class="modal-card-body">
                <!-- Content ... -->
            </section>
        </div>
    </div>

    <span id="participant-ids" data-ids="{{ encounter.getParticipantIds()|join('|') }}"></span>

    <script src="{{ asset('js/encounter_note_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_hp_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_swap_helper.js') }}"></script>
{% endblock %}