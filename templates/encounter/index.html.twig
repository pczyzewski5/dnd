{% extends 'base.html.twig' %}
{% block body %}
    <style>
        #participant-ids {
            display: none;
        }
    </style>
    <div class="buttons">
        <a class="button is-small is-primary" href="{{ path('participant_add', {'monsterId': '33626136-3261-6332-2d36-3137352d3131'}) }}">Dodaj potworka</a>
        <a class="button is-small is-danger" href="{{ path('encounter_delete') }}">Usuń potyczkę</a>
    </div>


    {% set participants = encounter.getParticipants().getAll() %}
    {% for key, participant in participants %}
        {% if participant.getId() == participants|first.getId() %}
            <div class="columns">
        {% endif %}

        <div class="column is-one-quarter">
            {{ include('encounter/participant.html.twig') }}

            <div class="modal">
                <div class="modal-background"></div>
                <div class="modal-card">
                    <section class="modal-card-body">
                        <button class="button is-small is-primary swap-id" data-actual-id="{{ participant.getId() }}" data-href="{{ path('participant_swap', {'participantId': participant.getId(), 'swapId': ':swapId'}) }}">zamień id</button>
                        <a class="button is-small is-warning" href="{{ path('participant_delete', {'participantId': participant.getId()}) }}">Usuń potworka</a>
                        <a class="button is-small is-info" href="{{ path('participant_duplicate', {'participantId': participant.getId()}) }}">Duplikuj potworka</a>
                    </section>
                </div>
            </div>
        </div>

        {% if key is divisible by(4) %}
            </div>
        {% endif %}
        {% if key is divisible by(4) and participants|length > key %}
            <div class="columns">
        {% endif %}
        {% if participants|last.getId() == participant.getId() %}
            </div>
        {% endif %}
    {% endfor %}

    <div class="modal">
        <div class="modal-background"></div>
        <div class="modal-card">
            <section class="modal-card-body">
                <!-- Content ... -->
            </section>
        </div>
    </div>

    <span id="participant-ids" data-ids="{{ encounter.getParticipants().getIds()|join('|') }}"></span>

    <script src="{{ asset('js/encounter_note_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_hp_helper.js') }}"></script>
    <script src="{{ asset('js/encounter_swap_helper.js') }}"></script>
{% endblock %}