{% extends 'base.html.twig' %}
{% block body %}
    <style>
        .monster-image {
            width: 100%;
            height: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            background-image: url("{{ asset('images/dnd5e_logo_opaque_10.png') }}");
        }
    </style>
    <div class="columns">
        <div class="column">
            {{ include('monster/form.html.twig') }}
        </div>
        <div class="column">
            {% set backgroundImage = '' %}
            {% if monsterEntity is defined %}
                {% set backgroundImage = 'style="background-image: url(' ~ getImageUrl(monsterEntity.getImage()) ~ ')"' %}
            {% endif %}
            <div class="monster-image" {{ backgroundImage|raw }}></div>
        </div>
    </div>

    <script src="{{ asset('js/item_card_image_helper.js') }}"></script>
{% endblock %}