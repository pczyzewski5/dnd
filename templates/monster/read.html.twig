{% extends 'base.html.twig' %}
{% block body %}
    <style>
        .monster-image {
            width: 100%;
            height: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            background-image: url("{{ asset('images/dnd5e_logo_opaque_10.png') }}");
        }
    </style>
    <div class="columns">
        <div class="column">
            <div class="buttons">
                <a class="button is-primary is-fullwidth" href="{{ path('monster_create') }}">Dodaj potworka</a>
                <a class="button is-warning is-fullwidth" href="{{ path('monster_update', {'id': id}) }}">Edytuj</a>
                <a class="button is-danger is-fullwidth" href="{{ path('monster_delete', {'id': id}) }}">Usuń</a>
            </div>
            <div>
                <table>
                    <tr>
                        <td>Nazwa</td>
                        <td>{{ monsterEntity.getName() }}</td>
                    </tr>
                    <tr>
                        <td>Klasa pancerza</td>
                        <td>{{ monsterEntity.getArmorClass() }}</td>
                    </tr>
                    <tr>
                        <td>Punkty wytrzymałości</td>
                        <td>{{ monsterEntity.getHitPoints() }}</td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="column">
            {% set backgroundImage = '' %}
            {% if monsterEntity is defined %}
                {% set backgroundImage = 'style="background-image: url(' ~ getImageUrl(monsterEntity.getImage()) ~ ')"' %}
            {% endif %}
            <div class="monster-image" {{ backgroundImage|raw }}></div>
        </div>
    </div>
{% endblock %}