<style>
   #saving-throws-background {
      background-image: url("{{ asset('images/saving_throws.jpg') }}");
      background-position: center;
      background-repeat: no-repeat;
      background-size: contain;
      width: inherit;
      height: inherit;
      display: flex;
      justify-content: center;
      align-items: center;
   }
   #saving-throws-container {
   {{ backgroundColor() }}
      width: 139px;
      height: 124px;
      font-size: 10px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-evenly;
      align-items: center;
   }
   .saving-throw {
      width: 16mm;
      height: 9mm;
      display: flex;
      flex-wrap: wrap;
   }
   .saving-throw div {
      display: flex;
      align-items:center;
      justify-content:center;
   }
   .saving-throw div:nth-child(1) {
   {{ backgroundColor() }}
      width: 16mm;
   }
   .saving-throw div:nth-child(2) {
   {{ backgroundColor() }}
      width: 8mm;
   }
   .saving-throw div:nth-child(3) {
   {{ backgroundColor() }}
      font-size: 14px;
      width: 8mm;
   }
</style>

<div id="saving-throws-section" class="character-card-section">
   <div id="saving-throws-background">
      <div id="saving-throws-container">
         {% for savingThrow in savingThrows %}
            <div class="saving-throw">
               <div><b>{{ savingThrow.enum.value|trans|upper }}</b></div>
               <div>{{ printMode ? false|dot : savingThrow.hasProficiency|dot }}</div>
               <div class="opaque">{{ printMode ? '&nbsp;' : savingThrow.value|value }}</div>
            </div>
         {% endfor %}
      </div>
   </div>
</div>