{% extends 'base.html.twig' %}
{% block body %}
    <style>
        .table-item {
            cursor: pointer;
        }
    </style>
    <a class="button is-primary is-fullwidth" href="{{ path('player_character_create') }}">Stwórz postać</a>
    <table class="table is-striped is-hoverable is-fullwidth">
        <thead>
        <tr>
            <th>#</th>
            <th>imię</th>
            <th>rasa</th>
            <th>klasa</th>
            <th>poziom</th>
            <th>kampania</th>
        </tr>
        </thead>
        <tbody>
        {% for key, character in characters %}
{#            <tr class="table-item" href="{{ path('character_read', {'id': character.getPlayerCharacter.getIdAsString#}
                ()}) }}">
                <td>{{ key + 1 }}</td>
                <td>character.characterName</td>
                <td>character.race|ucWords</td>
                <td>implement character class</td>
                <td>implement character level</td>
                <td>character.compaignName</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <script src="{{ asset('js/list_helper.js') }}"></script>
{% endblock %}
